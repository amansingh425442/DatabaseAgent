# Generate local secrets: python scripts/configure_local.py
POSTGRES_PASSWORD=
ANALYTICS_PASSWORD=
APP_PASSWORD=
ADMIN_DATABASE_URL=
ANALYTICS_DATABASE_URL=
APP_DATABASE_URL=
# Local human SQL access, provisioned by scripts/configure_reader.py
READER_PASSWORD=
READER_DATABASE_URL=
MODEL_FACTORY=
# MODEL_FACTORY is a user-selected module:function returning a LangChain chat model.
# Selected Gemini adapter: olist_agent.agent.gemini:create_model
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_TOOL_CALLS=12
MAX_EXECUTION_SECONDS=90
MAX_RETRIES=1
STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=500
MAX_PAYLOAD_BYTES=250000
